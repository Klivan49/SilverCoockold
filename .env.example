TELEGRAM_BOT_TOKEN=
# Получатели уведомлений через запятую. Пример: 123456789,987654321
# Если пусто, используется старое поле TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_IDS=
TELEGRAM_CHAT_ID=
# user_id админов через запятую (кому разрешены /start, /scan и кнопка скана).
# Пример: 123456789
# Если пусто, берутся получатели из TELEGRAM_CHAT_IDS / TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_IDS=
DB_PATH=./data/silverwatch.db
DRY_RUN=1
LOG_LEVEL=INFO
PROXY_URL=
# Внешний healthcheck (healthchecks.io, Uptime Kuma). Пусто — выключен.
HEALTHCHECK_URL=
# AI-фильтр: none | deepseek | openai. Без ключа работает как none.
LLM_PROVIDER=none
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Для OpenCode Go: ses_silverwatch_ai (заголовок x-opencode-session)
LLM_SESSION_ID=ses_silverwatch_ai
LLM_MAX_CALLS_PER_DAY=200
LLM_TIMEOUT=20
# Порог невыгодности 0..1: выше — не отправлять (0.4 = 40%).
AI_MAX_UNPROFITABLE_PROB=0.4
# Фото-анализ: primary deepseek | anthropic | none.
# Ключи могут быть общими с LLM_API_KEY.
VISION_PROVIDER=none
VISION_MODEL=deepseek-v4.1-flash
VISION_BASE_URL=https://opencode.ai/inference/go/openai/v1
VISION_API_KEY=
# Fallback для сложных/неуверенных фото; none — без fallback.
VISION_FALLBACK_PROVIDER=anthropic
VISION_FALLBACK_MODEL=claude-haiku-5-5
VISION_FALLBACK_BASE_URL=https://opencode.ai/inference/go/anthropic/v1
VISION_FALLBACK_API_KEY=
VISION_MIN_CONFIDENCE_FALLBACK=0.5
VISION_MAX_CALLS_PER_DAY=100
VISION_MAX_IMAGES=3
VISION_TIMEOUT=60
